# Normalize line endings in the repository, check out with native endings.
* text=auto

# Windows-centric files keep CRLF on every platform.
*.sln   text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.ps1   text eol=crlf

# Source and data files
*.cs    text diff=csharp
*.xml   text
*.md    text
*.json  text
*.py    text eol=lf

# Binary artifacts (never committed, listed for safety)
*.dll   binary
*.pdb   binary
*.zip   binary
