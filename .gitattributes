# Normalize line endings in the repository, check out with native endings.
* text=auto

# Windows-centric files keep CRLF on every platform.
*.sln   text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.ps1   text eol=crlf

# Source and data files. C# sources are LF in every checkout, so a Release build produces the same DLL on any
# machine (line endings are part of the compiled source).
*.cs    text diff=csharp eol=lf
*.xml   text
*.md    text
*.json  text
*.py    text eol=lf

# Binary artifacts (never committed, listed for safety)
*.dll   binary
*.pdb   binary
*.zip   binary
